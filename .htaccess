<IfModule mod_rewrite.c>
    RewriteEngine On

    # --------------------------------------------------------------
    # SECURITY: Block sensitive system files
    # --------------------------------------------------------------
    RewriteRule ^(.git|.env|composer\.json|composer\.lock|error_log|config\.php)$ - [R=404,NC,L]

    # --------------------------------------------------------------
    # FORCE HTTPS (Uncomment after SSL)
    # --------------------------------------------------------------
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # --------------------------------------------------------------
    # IMPROVED CLEAN URL FUNCTIONALITY
    # --------------------------------------------------------------
    
    # 1. Remove trailing slashes (except for directories)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [R=301,L]
    
    # 2. Remove index.html, index.php, and .html extensions from URLs
    RewriteCond %{THE_REQUEST} /index\.(html?|php)?[\s?] [NC]
    RewriteRule ^(.*)index\.(html?|php)?$ /$1 [R=301,L]
    
    RewriteCond %{THE_REQUEST} \s/+(.*?)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L,NE]
    
    # 3. Add .html extension internally for clean URLs
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]
    
    # 4. Handle root URL (optional - serves index.html automatically)
    # RewriteRule ^$ index.html [L]

</IfModule>


# --------------------------------------------------------------
# CUSTOM ERROR PAGES
# --------------------------------------------------------------
ErrorDocument 400 /404.html
ErrorDocument 401 /404.html
ErrorDocument 403 /404.html
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html
ErrorDocument 502 /500.html
ErrorDocument 503 /500.html
ErrorDocument 504 /500.html


# --------------------------------------------------------------
# ALLOW send_email.php FROM PUBLIC
# --------------------------------------------------------------
<Files "send_email.php">
    Require all granted
</Files>


# --------------------------------------------------------------
# CACHING
# --------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    # HTML: No cache
    ExpiresByType text/html "access plus 0 seconds"

    # CSS & JS
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"

    # Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"

    # Fonts
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

</IfModule>


# --------------------------------------------------------------
# GZIP COMPRESSION
# --------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>


# --------------------------------------------------------------
# SECURITY HEADERS
# --------------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>


# --------------------------------------------------------------
# DIRECTORY PROTECTION
# --------------------------------------------------------------
Options -Indexes


# --------------------------------------------------------------
# CHARACTER ENCODING
# --------------------------------------------------------------
AddDefaultCharset UTF-8